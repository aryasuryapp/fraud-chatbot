# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Database path
DATABASE_PATH=database.db

# Vector Store Backend (choose 'faiss' or 'weaviate')
VECTOR_STORE=weaviate

# Weaviate Configuration (only if VECTOR_STORE=weaviate)
# Local Docker instance (default)
WEAVIATE_URL=http://localhost:8080
# For Weaviate Cloud, uncomment and set:
# WEAVIATE_URL=https://your-cluster.weaviate.network
# WEAVIATE_API_KEY=your_api_key_here
WEAVIATE_COLLECTION=FraudDocuments

# Model settings
# Embedding model for document retrieval (768 dimensions, high quality)
# Alternatives: all-MiniLM-L6-v2 (384d, faster) or paraphrase-MiniLM-L6-v2 (384d)
EMBEDDING_MODEL=all-mpnet-base-v2
LLM_PROVIDER=openai
LLM_MODEL=gpt-3.5-turbo

# Reranking settings (set USE_RERANKER=true to enable)
USE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
INITIAL_RETRIEVAL_K=20

# RAG settings
# With min-max normalization, scores are now 0-1 range (same as cosine similarity)
RELEVANCE_THRESHOLD=0.5
MAX_CHUNKS=10

# Chunking settings for document ingestion
# CHUNK_SIZE: Maximum characters per chunk (default: 1000)
# CHUNK_OVERLAP: Character overlap between chunks for context continuity (default: 200)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

LOG_LEVEL=INFO
